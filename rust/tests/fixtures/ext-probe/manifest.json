{
  "manifest_version": 3,
  "name": "Probe",
  "version": "1.0",
  "description": "Test extension for SearchWin's bench: records which extension APIs answer under WebView2.",
  "action": { "default_popup": "popup.html" },
  "background": { "service_worker": "sw.js" },
  "permissions": ["storage", "tabs", "alarms", "scripting", "declarativeNetRequest", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["cs.js"], "run_at": "document_start" }]
}
